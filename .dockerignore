# Start by ignoring everything
*

# Allow only files needed to compute monorepo graph/install
!package.json
!bun.lock
!bunfig.toml
!turbo.json
!.npmrc

# Allow app code + internal workspaces it can depend on
!apps/**
!packages/**
!libs/**
!bots/**

# If Dockerfile is outside allowed paths, explicitly include it
!Dockerfile

# Re-ignore heavy/generated content inside allowed paths
**/node_modules
**/.turbo
**/dist
**/build
**/coverage
**/*.log
**/.env
**/.env.*